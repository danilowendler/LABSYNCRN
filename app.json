{
  "expo": {
    "name": "LabSync - Quiosque",
    "slug": "labsync-quiosque",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D274D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labsync.quiosque"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "assets/**/*",
      "**/*.png",
      "**/*.jpg",
      "**/*.webp",
      "**/*.ttf"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "18359796-5e02-4d18-8121-8a4e9b956f47"
      }
    },
    "android": {
      "package": "com.labsync.quiosque"
    }
  }
}
