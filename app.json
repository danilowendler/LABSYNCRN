{
  "expo": {
    "name": "LabSync - Quiosque",
    "slug": "labsync-quiosque",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D274D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labsync.quiosque"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D274D"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.labsync.quiosque"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": []
  }
}
